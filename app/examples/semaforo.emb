#conmentario
configuracion:
    numpin 13 ledRojo;
    numpin 12 ledAmarillo;
    numpin 11 ledVerde;
    
    configurar(ledRojo, salida);
    configurar(ledAmarillo, salida);
    configurar(ledVerde, salida);
fin

circuito:
    encender(ledRojo);
    esperar(3000);
    apagar(ledRojo);
    
    encender(ledAmarillo);
    esperar(1000);
    apagar(ledAmarillo);
    
    encender(ledVerde);
    esperar(3000);
    apagar(ledVerde);
fin